#!/usr/bin/env python3

# SPDX-FileCopyrightText: 2026 Greg Brandt <brandt.greg@gmail.com>
#
# SPDX-License-Identifier: MIT

"""Cut a release: tag pyproject.toml's version and publish it on GitHub.

Reads the version from pyproject.toml, creates the v<version> tag on the
current HEAD, pushes it, and publishes a release whose notes are generated
by GitHub — the same output as the "Generate release notes" button in the
web UI (merged PRs and new contributors since the previous tag).

Fails if a release for the tag already exists, or if the working tree is
dirty (the tag points at committed code, not your working directory — an
uncommitted version bump would silently release the wrong thing). A tag
that already exists is resumed as long as it points at HEAD (e.g. a run
that pushed the tag but failed to publish); if it points anywhere else,
that is a hard failure.

Requires the gh CLI (https://cli.github.com). Run from anywhere in the
repo: bin/create-release [-y]
"""

from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
import tomllib
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent


def fail(msg: str) -> int:
    print(f"create-release FAILED: {msg}", file=sys.stderr)
    return 1


def run(cmd: list[str]) -> str:
    """Run a command, returning its stripped stdout; abort on failure."""
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip()
        raise SystemExit(f"create-release FAILED: {' '.join(cmd)}\n{detail}")
    return result.stdout.strip()


def probe(cmd: list[str]) -> subprocess.CompletedProcess[str]:
    """Run a command without aborting, for existence checks."""
    return subprocess.run(cmd, capture_output=True, text=True)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Tag pyproject.toml's version and publish a GitHub release."
    )
    parser.add_argument(
        "-y", "--yes", action="store_true", help="skip the confirmation prompt"
    )
    args = parser.parse_args()

    if shutil.which("gh") is None:
        return fail("gh CLI not found on PATH (https://cli.github.com)")

    os.chdir(REPO_ROOT)
    with open("pyproject.toml", "rb") as f:
        version = tomllib.load(f)["project"]["version"]
    tag = f"v{version}"
    print(f"release: {tag} (from pyproject.toml)")

    dirty = probe(["git", "status", "--porcelain", "--untracked-files=no"])
    if dirty.returncode != 0:
        return fail("not a git work tree")
    if dirty.stdout.strip():
        return fail(
            "uncommitted changes: commit the version bump first"
            " (the tag points at HEAD, not your working directory)"
        )

    # Hard gate: an existing release means this version is already out.
    existing = probe(["gh", "release", "view", tag, "--json", "name"])
    if existing.returncode == 0:
        return fail(f"release {tag} already exists; nothing to do")

    head = run(["git", "rev-parse", "HEAD"])

    # A tag that already exists is only resumable if it points at HEAD
    # (e.g. a previous run pushed the tag but failed to publish).
    local_tag = probe(["git", "rev-parse", "-q", "--verify", f"refs/tags/{tag}"])
    if local_tag.returncode == 0:
        tagged = run(["git", "rev-parse", f"{tag}^{{commit}}"])
        if tagged != head:
            return fail(
                f"local tag {tag} points at {tagged[:7]}, not HEAD ({head[:7]});"
                f" move or delete it first: git tag -d {tag}"
            )
    remote_tags = probe(["git", "ls-remote", "--tags", "origin"])
    if remote_tags.returncode != 0:
        return fail(f"cannot reach origin: {remote_tags.stderr.strip()}")
    remote_commit = None
    for line in remote_tags.stdout.splitlines():
        sha, _, ref = line.partition("\t")
        ref = ref.strip()
        if ref == f"refs/tags/{tag}^{{}}":
            remote_commit = sha  # peeled commit of an annotated tag
            break
        if ref == f"refs/tags/{tag}":
            remote_commit = sha  # lightweight tag: the hash is the commit
    if remote_commit is not None and remote_commit != head:
        return fail(
            f"tag {tag} already exists on origin pointing at {remote_commit[:7]},"
            f" not HEAD ({head[:7]})"
        )

    current = run(["git", "rev-parse", "--abbrev-ref", "HEAD"])
    default = probe(["git", "symbolic-ref", "--short", "refs/remotes/origin/HEAD"])
    if default.returncode == 0 and current != default.stdout.strip().removeprefix(
        "origin/"
    ):
        print(
            f"warning: on branch {current!r}, not the default branch", file=sys.stderr
        )

    print(f"  tag:   {tag} at {head[:7]}")
    print("  notes: generated by GitHub since the previous tag")
    if not args.yes:
        try:
            answer = input("Create and publish this release? [y/N] ")
        except EOFError:
            return fail("aborted (no tty; pass --yes to skip the prompt)")
        if answer.strip().lower() not in ("y", "yes"):
            return fail("aborted")

    if local_tag.returncode != 0 and remote_commit is None:
        print(f"tagging {head[:7]} as {tag}...")
        run(["git", "tag", "-a", tag, "-m", f"slopkeeper {tag}"])
    if remote_commit is None:
        print("pushing tag...")
        run(["git", "push", "origin", tag])
    else:
        print(f"tag {tag} already on origin at {head[:7]}")
    print("publishing release...")
    url = run(
        [
            "gh",
            "release",
            "create",
            tag,
            "--verify-tag",
            "--generate-notes",
            "--title",
            tag,
        ]
    )
    print(f"published: {url}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
